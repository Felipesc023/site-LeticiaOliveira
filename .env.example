NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ATu6pX3Xg5NKo4fLnU1Rdg_6zgjLJ3R

# Server-only. Get from Supabase dashboard > Project Settings > API.
# Used by the scheduled-publish cron and admin server actions that need to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated list of admin emails (RF-001 allowlist). Also enforced in DB.
ADMIN_ALLOWLIST=admin@example.com,leticia@example.com

# AI editorial assistant (server-only, never exposed — RNF-003)
# Chave grátis, sem cartão: aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: override the model (default gemini-3.6-flash)
AI_MODEL=

# Unsplash — busca de imagens de capa no painel (server-only).
# Crie um app grátis em https://unsplash.com/developers e cole o "Access Key".
UNSPLASH_ACCESS_KEY=

# WhatsApp contact number (digits only, with country code)
NEXT_PUBLIC_WHATSAPP=5537999877441

# Google Analytics (optional; empty disables the script + consent banner)
NEXT_PUBLIC_GA_ID=

# Public site URL (for canonical/OG/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret guarding the /api/cron/publish endpoint
CRON_SECRET=
